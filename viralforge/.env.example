# Copie para .env e preencha. NUNCA comite o .env real.

# Provider de geração:
#   anthropic    → usa a API da Anthropic (precisa de ANTHROPIC_API_KEY). Padrão. Funciona na Vercel.
#   claude-code  → roteia para o SEU Claude Code (CLI `claude`, headless). Sem API key. Só local.
PROVIDER=claude-code

# --- Necessário só para PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
VIRAL_MODEL=claude-opus-4-8

# --- Opcional para PROVIDER=claude-code ---
# Modelo do seu Claude Code (vazio = usa o padrão da sua sessão). Ex: opus, sonnet, claude-opus-4-8
VIRAL_CC_MODEL=

PORT=3000
