# .env.example — variable names the upstream runner actually reads
# (from scripts/test_btc_5m_session_exit_sl.py). Copy to `.env`, fill in,
# then: chmod 600 .env   — and NEVER commit it.
#
# Use a DEDICATED wallet funded only with capital you can lose. See
# docs/SAFE_OPERATION.md.

# --- Signing / custody ---
# Private key of the DEDICATED trading wallet (hex). Prefer the Polymarket
# proxy-wallet model below so this is not your main holdings key.
PM_PRIVATE_KEY=

# Funder / proxy wallet address that holds the USDC used for trades.
PM_FUNDER=
# (alias also accepted by the runner)
# PM_ADDRESS=

# Polymarket signature type. 2 = proxy/email-wallet model (recommended).
PM_SIGNATURE_TYPE=2

# --- Polymarket CLOB API credentials ---
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=

# --- Optional overrides (defaults are the official hosts) ---
# PM_CLOB_BASE=https://clob.polymarket.com
